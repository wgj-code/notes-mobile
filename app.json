{
  "expo": {
    "name": "迪迪笔记",
    "slug": "notes-mobile",
    "version": "0.1.32",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.jpg",
    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wgjcode.notes",
      "infoPlist": {
        "CFBundleDisplayName": "迪迪笔记"
      }
    },
    "android": {
      "package": "com.wgjcode.notes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "ddf61deb-b15a-4c21-b1fb-ea58317449ea"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ],
    "owner": "wgj-code"
  }
}
