{
  "expo": {
    "name": "didi-Notes",
    "slug": "didi-notes",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.jpg",
    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wgjcode.notes"
    },
    "android": {
      "package": "com.wgjcode.notes"
    },
    "extra": {
      "eas": {
        "projectId": "ddf61deb-b15a-4c21-b1fb-ea58317449ea"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
